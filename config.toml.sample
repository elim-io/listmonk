[app]
# Interface and port where the app will run its webserver.  The default value
# of localhost will only listen to connections from the current machine. To
# listen on all interfaces use '0.0.0.0'. To listen on the default web address
# port, use port 80 (this will require running with elevated permissions).
address = "localhost:9000"

# Database.
[db]
host = "localhost"
port = 5432
user = "listmonk"
password = "listmonk"

# Ensure that this database has been created in Postgres.
database = "listmonk"

ssl_mode = "disable"
max_open = 25
max_idle = 25
max_lifetime = "300s"

# Optional space separated Postgres DSN params. eg: "application_name=listmonk gssencmode=disable"
params = ""

# Running on Google Cloud Run (see docs/docs/content/cloud-run.md).
# Everything here is off by default and changes nothing elsewhere.
# As environment variables: LISTMONK_cloud_run__ready=true etc.
[cloud_run]
# Serve GET /ready, which answers 200 only once Postgres answers, for
# Cloud Run's startup probe. Keep GET /health for the liveness probe.
ready = false

# Pass the admin event stream's messages (error toasts) between instances
# through Postgres LISTEN/NOTIFY, so that a browser sees the errors of every
# instance, not only of the one its stream is connected to.
events_relay = false

# End each admin event stream after this long (eg: "10m"), before Cloud Run's
# request timeout cuts it; the browser reconnects. "0" streams without limit.
events_max_age = "0"

# Write a keep-alive comment to the event stream this often (eg: "25s"). "0" sends none.
events_ping = "0"
